<!-- Wazuh Decoder: Falco Container Log Parser -->
<!-- Why: Wazuh Agent가 /var/log/containers/falco-*.log 수집 시
     컨테이너 런타임이 추가한 prefix 때문에 기본 JSON 디코더 실패
     로그: "2026-02-23T19:00:02... stdout F {"hostname":"k8s-worker3",...}"
     prematch가 prefix를 매칭하고, after_prematch로 JSON 부분을 파싱 -->

<decoder name="falco-container">
  <!-- Why: "stdout F {" 까지 매칭 → after_prematch는 "hostname":... 부터 시작
     하지만 JSON_Decoder는 불완전 JSON도 파싱 가능 (키=값 추출)
     "hostname" 필드가 있으면 Falco 로그로 확인 가능 -->
  <prematch>stdout F \{</prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>
